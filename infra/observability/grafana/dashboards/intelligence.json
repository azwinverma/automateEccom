{
  "uid": "nivaro-intelligence",
  "title": "Nivaro \u00b7 Intelligence health",
  "tags": [
    "nivaro"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Job last success (hours ago)",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - job_last_success_timestamp_seconds) / 3600",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Job runs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, outcome) (increase(job_runs_total[1d]))",
          "legendFormat": "{{job}} {{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(job_duration_seconds_bucket[1d])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Twin section age",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "twin_section_max_age_seconds",
          "legendFormat": "{{section}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Twin update lag p95 (SLO 60s)",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(twin_update_lag_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Product Brain oldest profile",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "product_brain_max_age_seconds / 3600",
          "legendFormat": "hours"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Data quality: variants without cost",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_quality_variants_without_cost_ratio",
          "legendFormat": "share"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Recommendations: open / expired unseen (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "recommendations_open",
          "legendFormat": "open"
        },
        {
          "refId": "B",
          "expr": "recommendations_expired_unseen_7d",
          "legendFormat": "expired unseen"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Operational gauge errors",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gauge) (increase(ops_collect_errors_total[1h]))",
          "legendFormat": "{{gauge}}"
        }
      ]
    }
  ]
}
