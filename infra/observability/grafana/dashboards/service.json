{
  "uid": "nivaro-service",
  "title": "Nivaro \u00b7 Service health",
  "tags": [
    "nivaro"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / s by status",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox: pending, oldest, dead",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_pending_events",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "outbox_oldest_pending_seconds",
          "legendFormat": "oldest (s)"
        },
        {
          "refId": "C",
          "expr": "outbox_dead_events",
          "legendFormat": "dead"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "celery_queue_backlog",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webhooks: unprocessed, oldest, dead",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "webhook_events_unprocessed",
          "legendFormat": "unprocessed"
        },
        {
          "refId": "B",
          "expr": "webhook_oldest_unprocessed_seconds",
          "legendFormat": "oldest (s)"
        },
        {
          "refId": "C",
          "expr": "webhook_events_dead",
          "legendFormat": "dead"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Integration calls by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (rate(integration_calls_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "AI requests / fallbacks / circuit",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(ai_requests_total[5m]))",
          "legendFormat": "{{status}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_fallback_total[5m]))",
          "legendFormat": "fallbacks"
        },
        {
          "refId": "C",
          "expr": "max(ai_circuit_open)",
          "legendFormat": "circuit open"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "AI cost (USD / hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(ai_cost_usd_total[1h]))",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Money & delivery",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "refunds_failed",
          "legendFormat": "refunds failed"
        },
        {
          "refId": "B",
          "expr": "cod_settlement_overdue",
          "legendFormat": "COD overdue"
        },
        {
          "refId": "C",
          "expr": "shipments_stuck",
          "legendFormat": "shipments stuck"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Publishing",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "channel_connections_need_attention",
          "legendFormat": "connections"
        },
        {
          "refId": "B",
          "expr": "listings_failed",
          "legendFormat": "listings failed"
        },
        {
          "refId": "C",
          "expr": "content_posts_failed",
          "legendFormat": "posts failed"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Auth events",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(auth_events_total[5m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Usage-limit blocks",
      "datasource": {
        "type": "prometheus",
        "uid": "nivaro-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resource) (rate(usage_limit_blocks_total[5m]))",
          "legendFormat": "{{resource}}"
        }
      ]
    }
  ]
}
