# Copy to .env for local development. Never commit real secrets.
COS_ENVIRONMENT=development
COS_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce_os
COS_REDIS_URL=redis://localhost:6379/0
COS_JWT_SECRET=dev-only-change-me-dev-only-change-me
COS_CORS_ORIGINS=["http://localhost:3000"]
COS_LOG_JSON=false
# Storage: local (dev) or s3 (MinIO in docker compose / S3 / R2 in staging+prod)
COS_STORAGE_BACKEND=local
# AI platform keys (optional in dev; sandbox provider is used when absent)
# COS_ANTHROPIC_API_KEY=
# COS_OPENAI_API_KEY=
# COS_GEMINI_API_KEY=
# COS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
