# Backend FastAPI base URL (server-side only; the browser never talks to it directly).
BACKEND_URL=http://localhost:8000

# Set to 1 ONLY for plain-http non-localhost dev hosts; refresh cookies are Secure by default.
SESSION_COOKIE_INSECURE=0

# Optional: run the Playwright E2E spec against a running stack.
# E2E_BASE_URL=http://localhost:3010
