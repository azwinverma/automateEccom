  "version": "1.0.0",
  "color": {
    "brand": {
      "blue": {
        "value": "#2563EB",
        "note": "Nivaro Blue. Primary action, the start of the loop."
      },
      "blueSoft": {
        "value": "#DBEAFE"
      },
      "blueStrong": {
        "value": "#1D4ED8",
        "note": "Hover/pressed for blue actions; blue text on tinted surfaces."
      },
      "teal": {
        "value": "#14B8A6",
        "note": "Nivaro Teal. Healthy, synced, completed loop. Fill only on light surfaces (3:1 fails for text)."
