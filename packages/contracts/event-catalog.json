{
  "$description": "Catalog of durable domain events published via the transactional outbox. The backend refuses to publish undeclared events and validates payloads against payload_schema. Payloads carry IDs, never secrets or full PII.",
  "version": "0.1.0",
  "events": [
    {
      "type": "platform.ping",
      "version": 1,
      "description": "Diagnostic event used by health checks and outbox tests.",
      "aggregate": "platform",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "note": {
            "type": "string"
          }
        },
        "required": [
          "note"
        ]
      }
    },
    {
      "type": "accounts.user_registered",
      "version": 1,
      "description": "A user account was created.",
      "aggregate": "accounts",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "enum": [
              "en",
              "ne"
            ]
          }
        },
        "required": [
          "user_id",
          "locale"
        ]
      }
    },
    {
      "type": "accounts.email_verification_requested",
      "version": 1,
      "description": "User asked for an email verification link; handler issues a token and sends it.",
      "aggregate": "accounts",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "user_id"
        ]
      }
    },
    {
      "type": "accounts.refresh_token_reuse_detected",
      "version": 1,
      "description": "A rotated refresh token was replayed; the session family was revoked (possible token theft).",
      "aggregate": "accounts",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "user_id",
          "session_id"
        ]
      }
    },
    {
      "type": "accounts.mfa_enabled",
      "version": 1,
      "description": "TOTP MFA enabled for a user.",
      "aggregate": "accounts",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "user_id"
        ]
      }
    },
    {
      "type": "merchants.merchant_created",
      "version": 1,
      "description": "A merchant (tenant) was created with an owner membership and default store.",
      "aggregate": "merchants",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "merchant_id",
          "owner_user_id"
        ]
      }
    },
    {
      "type": "merchants.invitation_created",
      "version": 1,
      "description": "A team invitation was created; handler emails the invite link.",
      "aggregate": "merchants",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "invitation_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "invitation_id",
          "role"
        ]
      }
    },
    {
      "type": "merchants.member_role_changed",
      "version": 1,
      "description": "A member's role changed.",
      "aggregate": "merchants",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "membership_id": {
            "type": "string",
            "format": "uuid"
          },
          "old_role": {
            "type": "string"
          },
          "new_role": {
            "type": "string"
          }
        },
        "required": [
          "membership_id",
          "old_role",
          "new_role"
        ]
      }
    },
    {
      "type": "merchants.member_removed",
      "version": 1,
      "description": "A member was removed from a merchant; their sessions keep working for other merchants only.",
      "aggregate": "merchants",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "membership_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "membership_id",
          "user_id"
        ]
      }
    },
    {
      "type": "billing.subscription_started",
      "version": 1,
      "description": "A subscription (trial or paid) started.",
      "aggregate": "billing",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subscription_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "subscription_id",
          "plan_code",
          "status"
        ]
      }
    },
    {
      "type": "billing.usage_threshold_reached",
      "version": 1,
      "description": "Usage for a metered resource crossed 70/85/100% of its limit in the current period.",
      "aggregate": "billing",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "threshold": {
            "enum": [
              70,
              85,
              100
            ]
          },
          "used": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "resource",
          "period",
          "threshold",
          "used",
          "limit"
        ]
      }
    },
    {
      "type": "ai.provider_circuit_opened",
      "version": 1,
      "description": "Circuit breaker opened for an AI provider/model after repeated failures.",
      "aggregate": "ai",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ]
      }
    },
    {
      "type": "catalog.product_created",
      "version": 1,
      "description": "A product was created (any source: app, import, AI studio).",
      "aggregate": "catalog",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "product_id"
        ]
      }
    },
    {
      "type": "catalog.product_updated",
      "version": 1,
      "description": "Product fields changed; consumers re-sync listings for the listed fields.",
      "aggregate": "catalog",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "product_id",
          "fields"
        ]
      }
    },
    {
      "type": "catalog.product_status_changed",
      "version": 1,
      "description": "Product lifecycle changed (draft/active/archived).",
      "aggregate": "catalog",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          },
          "to": {
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          }
        },
        "required": [
          "product_id",
          "from",
          "to"
        ]
      }
    },
    {
      "type": "catalog.variant_updated",
      "version": 1,
      "description": "A variant's price/SKU/barcode/dimensions/status changed.",
      "aggregate": "catalog",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "variant_id": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "product_id",
          "variant_id",
          "fields"
        ]
      }
    },
    {
      "type": "catalog.import_queued",
      "version": 1,
      "description": "A CSV import was uploaded; the handler processes it.",
      "aggregate": "catalog",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "import_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "import_id"
        ]
      }
    },
    {
      "type": "media.uploaded",
      "version": 1,
      "description": "Original bytes received; the handler scans, validates and builds derivatives.",
      "aggregate": "media",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "asset_id"
        ]
      }
    },
    {
      "type": "media.ready",
      "version": 1,
      "description": "Derivatives are available; quality flags tell the UI what to warn about.",
      "aggregate": "media",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "asset_id",
          "quality_flags"
        ]
      }
    },
    {
      "type": "studio.job_queued",
      "version": 1,
      "description": "An AI Product Studio draft was requested; the handler enqueues the worker task.",
      "aggregate": "studio",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "job_id"
        ]
      }
    },
    {
      "type": "channels.connected",
      "version": 1,
      "description": "A sales channel was connected or reconnected.",
      "aggregate": "channels",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "connection_id",
          "provider"
        ]
      }
    },
    {
      "type": "channels.connection_expired",
      "version": 1,
      "description": "Channel credentials stopped working; the seller must reconnect. Automations using it should pause.",
      "aggregate": "channels",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          }
        },
        "required": [
          "connection_id",
          "provider",
          "error_code"
        ]
      }
    },
    {
      "type": "webhooks.received",
      "version": 1,
      "description": "A verified, de-duplicated provider webhook was recorded; the handler routes it.",
      "aggregate": "webhooks",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "webhook_event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "webhook_event_id"
        ]
      }
    },
    {
      "type": "listings.sync_requested",
      "version": 1,
      "description": "A channel listing must be reconciled with the product (publish/update/unpublish).",
      "aggregate": "listings",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "listing_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "listing_id"
        ]
      }
    },
    {
      "type": "listings.sync_failed",
      "version": 1,
      "description": "A listing could not be synced after retries; surfaces in the Exception Inbox.",
      "aggregate": "listings",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "listing_id": {
            "type": "string",
            "format": "uuid"
          },
          "error_code": {
            "type": "string"
          }
        },
        "required": [
          "listing_id",
          "error_code"
        ]
      }
    },
    {
      "type": "content.publish_failed",
      "version": 1,
      "description": "A scheduled post could not be published after retries (or needs reconnect); surfaces in the Exception Inbox.",
      "aggregate": "content",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "post_id": {
            "type": "string",
            "format": "uuid"
          },
          "error_code": {
            "type": "string"
          }
        },
        "required": [
          "post_id",
          "error_code"
        ]
      }
    },
    {
      "type": "video.job_queued",
      "version": 1,
      "description": "A video job (Auto Reel or premium) was requested; the handler enqueues the media worker task.",
      "aggregate": "video",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "job_id"
        ]
      }
    }
  ]
}