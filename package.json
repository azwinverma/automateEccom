{
  "name": "commerce-os",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "tokens": "pnpm --filter @commerce-os/design-system build",
    "web:dev": "pnpm --filter @commerce-os/web dev",
    "web:test": "pnpm --filter @commerce-os/web test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:all": "bash scripts/dev.sh",
    "dev:prod": "bash scripts/dev.sh --prod",
    "mobile": "bash scripts/mobile.sh",
    "make-admin": "bash scripts/make-admin.sh"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    }
  }
}
